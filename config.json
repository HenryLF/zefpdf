{
  "server": {
    "cwd": "/home/zub/Documents/AbbeGregoire2026/src",
    "port": 3000,
    "ignore": [
      "node_modules"
    ],
    "ignoreFiles": ".localignore",
    "openBrowser": true
  },
  "plugins": {
    "enabled": [
      "rotate",
      "zoom",
      "clock",
      "timer",
      "planning",
      "geogebra",
      "video",
      "draw",
      "placement"
    ]
  },
  "keys": {
    "tab.cycle": "b",
    "reader.scrollDown": "PageDown",
    "reader.scrollUp": "PageUp",
    "reader.pageStrip": "Tab",
    "reader.close": "Escape",
    "library.next": "PageDown",
    "library.prev": "PageUp",
    "library.activate": "Tab",
    "classes.open": "c",
    "rotate.page": "r",
    "draw.pick": "Enter"
  },
  "reader": {
    "scrollStep": 20,
    "pageGap": 0,
    "maxPageWidth": 100,
    "smoothScroll": true,
    "cardWidth": 200,
    "panelOpacity": 55,
    "fullscreen": true,
    "pageCounter": {
      "bgOpacity": 90,
      "textColor": "#9aa3ad",
      "textOpacity": 100,
      "fontSize": 12
    }
  }
}
